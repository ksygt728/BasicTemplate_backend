pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
  }

  environment {
    // Git repository URL
    REPO_URL = 'https://github.com/ksygt728/BasicTemplate_backend.git'

    // Git Tag에 사용할 변수
    GIT_TAG_ID = 'ksygt728'
    GIT_TAG_EMAIL = 'ksygt728@gmail.com'

    // Git workspace 기준 docker-compose 파일 경로
    COMPOSE_FILE_PATH = 'backend/app'

    // 원격 서버 기준 배포 경로
    DEPLOY_PATH = '/home/ec2-user/deploy'

    // Docker registry info
    REGISTRY   = 'docker.io/seungyeon728'
    IMAGE_NAME = 'cbms-back'

    // Local 판단 변수
    IS_LOCAL = "${params.DEPLOY_SERVER == 'localhost' || params.DEPLOY_SERVER == '127.0.0.1'}"
  }

  stages {

    stage('Init Params') {
      steps {
        echo "================ Jenkins Build Parameters ================"
        echo "ENV               : ${params.ENV}"
        echo "BRANCH            : ${params.BRANCH}"
        echo "DEPLOY_SERVER     : ${params.DEPLOY_SERVER}"
        echo "PORT              : ${params.BACK_PORT}"
        echo "COMPOSE_FILE_PATH : ${COMPOSE_FILE_PATH}"
        echo "※ localhost / 127.0.0.1 은 Local 배포, Deploy 단계 스킵"
        echo "=========================================================="
      }
    }

    stage('Checkout') {
      steps {
        echo "================ [CHECKOUT] ================="
        git branch: params.BRANCH,
            credentialsId: 'git-credential',
            url: env.REPO_URL
        echo "================ ✅ CHECKOUT DONE ================="
      }
    }

    stage('Prepare Tag') {
      steps {
        script {
          def tz = TimeZone.getTimeZone('Asia/Seoul')
          def dateStr = new Date().format('yyyy-MM-dd_HH', tz)
          env.TAG = "back-${params.ENV}-${dateStr}-${env.BUILD_NUMBER}"

          echo "================ [TAG] ================="
          echo "TAG = ${env.TAG}"
          echo "================ ======================="
        }
      }
    }

    stage('Maven Test') {
      steps {
        echo "================ [TEST] Maven Test ================="
        sh """
          cd ${WORKSPACE}/${COMPOSE_FILE_PATH}
          ./mvnw clean test -Dspring.profiles.active=test
        """
        echo "================ ✅ TEST PASSED ================="
      }
    }

    stage('Docker Build') {
      steps {
        echo "================ [DOCKER] Build ================="
        sh """
          cd ${WORKSPACE}/${COMPOSE_FILE_PATH}
          docker build --no-cache -t ${REGISTRY}/${IMAGE_NAME}-${params.ENV}:${TAG} .
        """
        echo "================ ✅ DOCKER BUILD DONE ================="
      }
    }

    stage('Docker Push (Remote Only)') {
      when {
        expression { env.IS_LOCAL != "true" }
      }
      steps {
        echo "================ [DOCKER] Login & Push ================="

        withCredentials([usernamePassword(
          credentialsId: 'dockerhub-credential',
          usernameVariable: 'DOCKER_USER',
          passwordVariable: 'DOCKER_PASS'
        )]) {
          sh """
            echo "\$DOCKER_PASS" | docker login -u "\$DOCKER_USER" --password-stdin
            docker push ${REGISTRY}/${IMAGE_NAME}-${params.ENV}:${TAG}
            docker logout
          """
        }

        echo "================ ✅ DOCKER PUSH DONE ================="
      }
    }

    stage('Deploy') {
      when {
        expression { env.IS_LOCAL != "true" }
      }
      steps {
        echo "================ [DEPLOY][REMOTE] Detected ================"
        echo "▶▶ Target server : ${params.DEPLOY_SERVER}"

        sshagent(credentials: ['deploy-ssh-key']) {
          sh """
            ssh -o StrictHostKeyChecking=no ec2-user@${params.DEPLOY_SERVER} "mkdir -p ${DEPLOY_PATH}"

            scp -o StrictHostKeyChecking=no \
                ${WORKSPACE}/${COMPOSE_FILE_PATH}/docker-compose.yml \
                ec2-user@${params.DEPLOY_SERVER}:${DEPLOY_PATH}/docker-compose.yml

            scp -o StrictHostKeyChecking=no \
                ${WORKSPACE}/${COMPOSE_FILE_PATH}/application-${params.ENV}.yml \
                ec2-user@${params.DEPLOY_SERVER}:${DEPLOY_PATH}/application-${params.ENV}.yml

            ssh -o StrictHostKeyChecking=no ec2-user@${params.DEPLOY_SERVER} "
              docker pull ${REGISTRY}/${IMAGE_NAME}-${params.ENV}:${TAG} && \
              cd ${DEPLOY_PATH} && \
              REGISTRY=${REGISTRY} IMAGE_NAME=${IMAGE_NAME} ENV=${params.ENV} IMAGE_TAG=${TAG} BACK_PORT=${params.BACK_PORT} docker-compose up -d
            "
          """
        }

        echo "================ ✅ [DEPLOY][REMOTE] Completed ================"
      }
    }

    stage('Git Tag') {
      when {
        expression { env.IS_LOCAL != "true" }
      }
      steps {
        echo "▶▶ [GIT][REMOTE] Create Git tag"

        withCredentials([usernamePassword(
          credentialsId: 'git-credential',
          usernameVariable: 'GIT_USER',
          passwordVariable: 'GIT_PASS'
        )]) {
          sh """
            git config user.name "${GIT_TAG_ID}"
            git config user.email "${GIT_TAG_EMAIL}"

            git tag -a ${TAG} -m "back deploy ${params.ENV}"

            git push https://${GIT_USER}:${GIT_PASS}@github.com/ksygt728/BasicTemplate_backend.git ${TAG}
          """
        }

        echo "✅ [GIT][REMOTE] Tag pushed"
      }
    }  
  }
}