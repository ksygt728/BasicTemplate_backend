pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
  }

  environment {
    // Git repository URL
    REPO_URL = 'https://github.com/ksygt728/BasicTemplate_backend.git'

    // Git workspace 기준 docker-compose 파일 경로
    COMPOSE_FILE_PATH = 'backend/app'

    // 원격 서버 기준 배포 경로
    DEPLOY_PATH = '/Users/seungyeonkim/deploy/backend'

    // Docker registry info
    REGISTRY   = 'docker.io/ksygt728'
    IMAGE_NAME = 'cbms-back'

    // SSH 키 경로
    SSH_KEY_PATH = '/var/jenkins_home/.ssh/id_ed25519'

    // Local 판단 변수
    IS_LOCAL = "${params.DEPLOY_SERVER == 'localhost' || params.DEPLOY_SERVER == '127.0.0.1'}"
  }

  stages {

    stage('Init Params') {
      steps {
        echo "================ Jenkins Build Parameters ================"
        echo "ENV               : ${params.ENV}"
        echo "BRANCH            : ${params.BRANCH}"
        echo "DEPLOY_SERVER     : ${params.DEPLOY_SERVER}"
        echo "PORT              : ${params.BACK_PORT}"
        echo "COMPOSE_FILE_PATH : ${COMPOSE_FILE_PATH}"
        echo "※ localhost / 127.0.0.1 은 Local 배포, Deploy 단계 스킵"
        echo "=========================================================="
      }
    }

    stage('Checkout') {
      steps {
        echo "================ [CHECKOUT] ================="
        git branch: params.BRANCH,
            credentialsId: 'git-credential',
            url: env.REPO_URL
        echo "================ ✅ CHECKOUT DONE ================="
      }
    }

    stage('Prepare Tag') {
      steps {
        script {
          def tz = TimeZone.getTimeZone('Asia/Seoul')
          def dateStr = new Date().format('yyyy-MM-dd_HH', tz)
          env.TAG = "back-${params.ENV}-${dateStr}-${env.BUILD_NUMBER}"

          echo "================ [TAG] ================="
          echo "TAG = ${env.TAG}"
          echo "================ ======================="
        }
      }
    }

    stage('Maven Test') {
      steps {
        echo "================ [TEST] Maven Test ================="
        sh """
          cd ${WORKSPACE}/${COMPOSE_FILE_PATH}
          ./mvnw clean test -Dspring.profiles.active=test
        """
        echo "================ ✅ TEST PASSED ================="
      }
    }

    stage('Docker Build') {
      steps {
        echo "================ [DOCKER] Build ================="
        sh """
          cd ${WORKSPACE}/${COMPOSE_FILE_PATH}
          docker build -t ${REGISTRY}/${IMAGE_NAME}-${params.ENV}:${TAG} .
        """
        echo "================ ✅ DOCKER BUILD DONE ================="
      }
    }

    stage('Docker Push (Remote Only)') {
      when {
        expression { env.IS_LOCAL != "true" }
      }
      steps {
        echo "================ [DOCKER] Push ================="
        sh "docker push ${REGISTRY}/${IMAGE_NAME}-${params.ENV}:${TAG}"
        echo "================ ✅ DOCKER PUSH DONE ================="
      }
    }

    stage('Deploy') {
      when {
        expression { env.IS_LOCAL != "true" }
      }
      steps {
        echo "================ [DEPLOY] ================="
        echo "Target : ${params.DEPLOY_SERVER}"

        sshagent(credentials: ['git-credential']) {
          sh """
            ssh deploy@${params.DEPLOY_SERVER} "mkdir -p ${DEPLOY_PATH}"

            scp ${WORKSPACE}/${COMPOSE_FILE_PATH}/docker-compose.yml \
                deploy@${params.DEPLOY_SERVER}:${DEPLOY_PATH}/docker-compose.yml

            scp ${WORKSPACE}/${COMPOSE_FILE_PATH}/.env.${params.ENV} \
                deploy@${params.DEPLOY_SERVER}:${DEPLOY_PATH}/.env.${params.ENV}

            ssh deploy@${params.DEPLOY_SERVER} '
              docker pull ${REGISTRY}/${IMAGE_NAME}-${params.ENV}:${TAG}
              cd ${DEPLOY_PATH}
              IMAGE_TAG=${TAG} ENV=${params.ENV} BACK_PORT=${params.BACK_PORT} \
              docker compose up -d --build
            '
          """
        }

        echo "================ ✅ DEPLOY DONE ================="
      }
    }

    stage('Git Tag') {
      when {
        expression { env.IS_LOCAL != "true" }
      }
      steps {
        echo "================ [GIT TAG] ================="
        sh """
          git tag -a ${TAG} -m "back deploy ${params.ENV}"
          git push origin ${TAG}
        """
        echo "================ ✅ GIT TAG PUSHED ================="
      }
    }
  }
}